  time_limit = 6 * (60 * 60 * 1000); 
  pTime = new Date(y+"/"+m +"/"+d+" "+h+":00:00");
  cTime = new Date();
  diff =(cTime - pTime);
  if(diff <= time_limit) {
    document.write("<IMG src='/news/images/newmark.gif' border='0'>");
  }
}
